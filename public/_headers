# Cloudflare Pages HTTP Cache-Control and Performance Headers

# Long-term immutable caching for 3D frame sequences, webm videos, and static assets
/Assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.webm
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

# HTML Entry Point - Ensure fresh updates are checked while relying on cached assets
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Global Security and Content Protection
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
